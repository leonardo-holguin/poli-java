<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>Lexicron</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Lexicron</name>

    <developers>
        <developer>
            <id>alexander-david-gualdron-chaparro</id>
            <name>Alexander David Gualdron Chaparro</name>
        </developer>
        <developer>
            <id>daniel-grande-gordillo</id>
            <name>Daniel Grande Gordillo</name>
        </developer>
        <developer>
            <id>laura-sofia-gutierrez-rico</id>
            <name>Laura Sofia Gutiérrez Rico</name>
        </developer>
        <developer>
            <id>leonardo-holguin-arias</id>
            <name>Leonardo Holguin Arias</name>
        </developer>
        <developer>
            <id>sandra-milena-gutierrez-madrigal</id>
            <name>Sandra Milena Gutiérrez Madrigal</name>
        </developer>
    </developers>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <javafx.version>24</javafx.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>

                <configuration>
                    <mainClass>com.example.lexicron.LexicronApp</mainClass>
                </configuration>

            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <systemProperties>
                        <systemProperty>
                            <key>file.encoding</key>
                            <value>UTF-8</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <reportOutputDirectory>docs</reportOutputDirectory>
                    <destDir>api</destDir>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>